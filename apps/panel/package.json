{
  "name": "@gh-panel/panel",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsx scripts/build.ts",
    "start": "node --enable-source-maps dist/server.js",
    "dev:server": "tsx watch --clear-screen=false src/index.ts",
    "dev:ui": "tsx scripts/build.ts --ui --watch",
    "typecheck": "tsc -p tsconfig.json && tsc -p src/ui/client/tsconfig.json"
  },
  "dependencies": {
    "@gh-panel/shared": "*",
    "@hono/node-server": "^1.13.0",
    "dotenv": "^18.0.5",
    "hono": "^4.6.0",
    "proxy": "^2.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
