# Template for local development. Copy it to .env (gitignored) and adjust:
#   cp .env.example .env
# Loaded by `npm run dev` and `npm run start:local`. On a GitHub runner these
# values come from repository secrets instead (see README.md).

# --- Local mode -------------------------------------------------------------
# Listen on this address instead of the Tailscale IP. Setting it skips
# Tailscale and disables the ssh service, so a dev machine is left untouched.
BIND_ADDRESS=127.0.0.1
PANEL_PORT=3000

# --- Panel login (also the SSH user/password and the 9router dashboard password)
PANEL_USERNAME=admin
PANEL_PASSWORD=change-me

# --- Proxy: "username:password" for the HTTP proxy on port 3128
PROXY_CREDENTIALS=proxy:change-me

# --- Only needed on a real runner; unused while BIND_ADDRESS is set
# TAILSCALE_AUTHKEY=tskey-auth-xxxxxxxxxxxx
# Optional: the machine name in your tailnet (default: github-ubuntu)
# TAILSCALE_HOSTNAME=github-ubuntu
