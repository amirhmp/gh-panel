{
  "name": "gh-panel",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "npm run build -w @gh-panel/panel",
    "start": "npm start -w @gh-panel/panel",
    "dev": "npm run dev:server -w @gh-panel/panel",
    "dev:ui": "npm run dev:ui -w @gh-panel/panel",
    "client": "npm run dev:app -w @gh-panel/client",
    "client:build": "npm run build:app -w @gh-panel/client",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "zip": "tsx scripts/zip.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky || echo husky skipped"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "archiver": "^8.0.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.9",
    "prettier-plugin-organize-imports": "^4.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
